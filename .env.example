# Copy to .env and fill in real values. Never commit .env.

# --- App ---
ENVIRONMENT=development
API_PORT=8000
API_HOST=0.0.0.0

# --- Paths ---
DATA_DIR=data
REGULATIONS_DIR=data/regulations
RUNTIME_RULES_DIR=data/runtime_rules
TEST_PLANS_DIR=data/test_plans
VECTOR_STORE_DIR=data/vector_store
UPLOAD_DIR=data/uploads

# --- Database ---
DATABASE_URL=sqlite:///./buildcheck.db

# --- LLM / RAG ---
GROQ_API_KEY=
GROQ_MODEL_NAME=llama3-70b-8192
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2
EMBEDDING_DIM=384
RAG_TOP_K=8

# --- RAG ingestion (chunking) ---
RAG_MAX_CHUNK_TOKENS=512
RAG_CHUNK_OVERLAP_TOKENS=50

# --- RAG retrieval (dense / BM25 / RRF fusion) ---
RAG_TOP_K_DENSE=20
RAG_TOP_K_BM25=20
RAG_TOP_K_FINAL=8
RAG_RRF_K=60

# --- RASE (regulation -> RuntimeRuleDefinition drafting) ---
RASE_DRAFT_TEMPERATURE=0.0
RASE_MIN_RETRIEVAL_CHUNKS=3

# --- Upload limits ---
# A vectorized/traced DXF can legitimately be tens of MB (many thousands of
# tiny line/polygon fragments) -- sized with real headroom above real
# observed uploads, not just a PDF-sized default.
MAX_UPLOAD_SIZE_MB=100

# --- Geometry ---
GEOMETRY_TOLERANCE_M=0.05
DEFAULT_POINTS_PER_METRE=72.0

# --- Logging ---
LOG_LEVEL=INFO
LOG_JSON=false

# Optional Qwen2.5-VL semantic extraction
VISION_ENABLED=false
VISION_BACKEND=smolvlm
# VISION_MODEL_NAME=            # optional override; empty = backend's own default
VISION_RENDER_DPI=200
VISION_MAX_NEW_TOKENS=3000

# Region-focused second passes (independent-Vision-validation mode only):
# each region Vision (or the deterministic caption-anchored locator in
# backend/cv_extraction/region_detection.py) finds gets re-rendered directly
# from the PDF at a higher DPI and re-read on its own, instead of relying on
# the single full-page pass to catch small print (setback decimals, area-
# statement table cells, height dimension lines). Keep these modest -- many
# hosted-API free/low tiers enforce a low output-tokens-per-minute ceiling
# shared across the full-page pass plus every focus pass on the same page.
VISION_FOCUS_MAX_NEW_TOKENS=800
VISION_SITE_FOCUS_RENDER_DPI=400
VISION_AREA_FOCUS_MAX_NEW_TOKENS=800
VISION_AREA_FOCUS_RENDER_DPI=450
VISION_HEIGHT_FOCUS_MAX_NEW_TOKENS=800
VISION_HEIGHT_FOCUS_RENDER_DPI=400

# --- 'api' vision backend only (VISION_BACKEND=api) ---
# No local model weights, no torch/transformers install -- calls a hosted
# OpenAI-Chat-Completions-compatible vision endpoint over HTTP. Use this on
# machines without enough RAM/VRAM for smolvlm/qwen. Defaults to Groq's
# OpenAI-compatible endpoint, reusing GROQ_API_KEY above if VISION_API_KEY
# is left blank.
# VISION_API_BASE_URL=https://api.groq.com/openai/v1
# VISION_API_KEY=
# VISION_API_MODEL=             # e.g. qwen/qwen3.6-27b on Groq, gpt-4o on OpenAI -- check the
#                                # provider's current vision-model docs, these lists change often
# VISION_API_TEMPERATURE=0.0
# VISION_API_JSON_MODE=true
# VISION_API_TIMEOUT_SECONDS=120
# VISION_API_MAX_RETRIES=2
# VISION_API_MAX_IMAGE_PIXELS=33177600  # downscale larger renders (preserving aspect ratio); 0 disables
